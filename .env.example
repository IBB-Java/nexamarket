# Gerekirse varsayılan bağlantı bilgisini burada değiştirip dosyayı .env olarak kaydet.
DB_URL=jdbc:postgresql://localhost:5432/nexamarket
DB_USERNAME=nexamarket
DB_PASSWORD=nexamarket

# Güvenlik ve destek servisleri
AUTH_JWT_SECRET=replace-with-a-long-base64-secret-in-real-environments
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=nexamarket
RABBITMQ_PASSWORD=nexamarket
REDIS_HOST=localhost
REDIS_PORT=6379
STOCK_LOCK_TYPE=redisson
ELASTICSEARCH_URIS=http://localhost:9200
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nexamarket-products

# Gerçek e-posta gönderimi (Gmail)
# Gmail hesabında iki adımlı doğrulamayı açıp "Uygulama şifresi" oluşturun.
# Bu örnek dosyayı .env adıyla kopyalayın; .env Git'e gönderilmez.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-sender@gmail.com
MAIL_PASSWORD=replace-with-your-16-character-gmail-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=your-sender@gmail.com
