# Gerekirse varsayılan bağlantı bilgisini burada değiştirip dosyayı .env olarak kaydet.
DB_URL=jdbc:postgresql://localhost:5432/nexamarket
DB_USERNAME=nexamarket
DB_PASSWORD=nexamarket

# Güvenlik ve destek servisleri
# Üretimde bu geliştirme anahtarını güçlü, rastgele ve Base64/Base64URL kodlu bir anahtarla değiştirin.
AUTH_JWT_SECRET=bmV4YW1hcmtldC1kZXZlbG9wbWVudC1zZWNyZXQta2V5LTIwMjY=
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=nexamarket
RABBITMQ_PASSWORD=nexamarket
REDIS_HOST=localhost
REDIS_PORT=6379
STOCK_LOCK_TYPE=redisson
ELASTICSEARCH_URIS=http://localhost:9200
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=nexamarket
MINIO_SECRET_KEY=nexamarket
MINIO_BUCKET=nexamarket-products

# Gerçek e-posta gönderimi (Gmail)
# Gmail hesabında iki adımlı doğrulamayı açıp "Uygulama şifresi" oluşturun.
# Bu örnek dosyayı .env adıyla kopyalayın; .env Git'e gönderilmez.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=your-address@gmail.com
